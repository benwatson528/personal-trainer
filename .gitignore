# Secrets — never commit. The Google Drive OAuth client and token live here,
# kept separate from the non-secret content-config (which now lives in Drive).
secrets/

# Local data/ is a scratch mirror of the live Google Drive contents (state,
# sessions, history, generated output and programme material). Nothing in it is
# committed to this public repo; the test suite uses tests/fixtures/ instead.
# Leading slash anchors this to the repo root so it does NOT match
# tests/fixtures/data/.
/data/
